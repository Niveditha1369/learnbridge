# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Production PostgreSQL Database URL (Render automatically provides this)
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://learnbridge_user:password@dpg-xxx.render.com/learnbridge

# Port (assigned dynamically by Render)
PORT=5000
